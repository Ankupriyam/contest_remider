# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/contest_reminder?retryWrites=true&w=majority

# Google OAuth (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Auth & encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-char-or-longer-random-string-for-session-signing
ENCRYPTION_KEY=replace-with-64-char-hex-string-for-token-encryption

# Application URL (no trailing slash)
APP_URL=http://localhost:8080

# Optional: CLIST API (preferred contest source)
CLIST_USERNAME=
CLIST_API_KEY=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Cron jobs (set to false for local dev without background sync)
ENABLE_CRON=true
